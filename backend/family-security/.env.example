# Copy to .env on the SERVER ONLY. Never add this file to GitHub or the Android app.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/korosh_nova?sslmode=require
# Generate a unique random secret of at least 32 bytes. Keep server-side only.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
FAMILY_NAME=خانواده کوروش نوا
# Enter the two parent identities before app installation. No self-claim from a new install is allowed.
FAMILY_PARENT_FATHER_EMAIL=father@example.com
FAMILY_PARENT_FATHER_NAME=پدر
FAMILY_PARENT_MOTHER_EMAIL=mother@example.com
FAMILY_PARENT_MOTHER_NAME=مادر
# Exactly one primary owner; the other registered parent is the second security administrator.
FAMILY_PRIMARY_OWNER=father
# SMTP must be configured with an email provider reachable by the family.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Korosh Nova Security <mailer@example.com>
CORS_ORIGIN=*
